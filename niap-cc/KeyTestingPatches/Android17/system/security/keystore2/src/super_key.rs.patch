+// Helper function to format hex strings without spaces (Performance optimized)
+fn to_hex(data: &[u8]) -> String {
+    use std::fmt::Write; // write! macro
+    let mut s = String::with_capacity(data.len() * 2);
+    for b in data {
+        write!(s, "{:02x}", b).unwrap();
+    }
+    s
